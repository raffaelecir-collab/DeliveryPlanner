/**
 * Generazione del PDF "Rapporto di Intervento", sovrapponendo SOLO i dati compilati dalla squadra
 * al layout base fornito dall'utente: l'immagine di sfondo a piena pagina è lo stesso modulo
 * cartaceo SICURITALIA (con logo, intestazione, sezioni, tabelle, caselle già disegnati), e ogni
 * valore viene scritto in overlay a coordinate assolute (cm, poi convertite in mm per il CSS) sopra
 * di essa. Nessun campo "amministrativo" (cliente, tecnico, causale, richiesto da, regime, tipo
 * impianto, cod. equipment...) viene scritto: sono già nel modulo cartaceo o restano da compilare
 * a mano, non essendo compilati dalla squadra.
 *
 * Costruito come HTML (sfondo a piena pagina + <div> posizionati in absolute) e convertito in PDF
 * (Utilities.newBlob(...).getAs(...)), poi archiviato nella cartella Documenti Drive dell'intervento
 * (vedi Documenti.gs, stessa cartella visibile dal pulsante 📎 "Documenti" già esistente) —
 * rigenerato e SOVRASCRITTO (il PDF precedente viene cestinato) ad ogni salvataggio del Rapporto
 * (salvaRapportoIntervento, Interventions.gs), così esiste sempre un solo PDF aggiornato per
 * intervento.
 *
 * Coordinate: riprese ESATTAMENTE (in cm) dal file "rapporto_intervento_layout_base.html" fornito
 * dall'utente — una mappatura pixel-precisa dello stesso sfondo con veri <input>/<textarea>
 * posizionati in absolute, molto più affidabile di una misurazione manuale — vedi COORD_RAPPORTO_.
 * Eccezione: le caselle/il testo della tabella articoli (COORD_RAPPORTO_.articoli) erano
 * costantemente ~0.14cm più in basso nell'immagine di sfondo rispetto a quanto dichiarato nel file
 * (scostamento verificato pixel per pixel sulle 5 righe, mentre tutte le altre sezioni combaciavano
 * esattamente) — per quella tabella le coordinate sono quindi state ri-misurate direttamente
 * sull'immagine di sfondo effettiva.
 * Font Courier nero per i valori compilati (stessa scelta tipografica del file fornito), a
 * differenza delle etichette/testi di stampa del modulo che sono in blu.
 */

var TIPI_INTERVENTO_RAPPORTO_ = ['SOPRALLUOGO', 'INSTALLAZIONE', 'COLLAUDO', 'SMONTAGGIO', 'MANUTENZIONE PREVENTIVA', 'MANUTENZIONE CORRETTIVA'];
var UNITA_OPERATIVA_RAPPORTO_ = 'SITE SPA';

/** Sfondo a piena pagina: modulo cartaceo SICURITALIA "Rapporto di Intervento" (da Layout_RIT.odg fornito dall'utente). */
var SFONDO_RAPPORTO_BASE64_ = '';

/** cm -> mm (le coordinate di COORD_RAPPORTO_ sono in cm, stessa unità del file mappato fornito). */
function cmMm_(cm) {
  return (cm * 10).toFixed(2) + 'mm';
}

function escapeHtmlPdf_(s) {
  return String(s === undefined || s === null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

/** <div> posizionato in absolute alle coordinate (cm) date. */
function overlayPdf_(xCm, yCm, contenutoHtml, stileExtra) {
  return '<div style="position:absolute;left:' + cmMm_(xCm) + ';top:' + cmMm_(yCm) + ';' + (stileExtra || '') + '">' + contenutoHtml + '</div>';
}

/** Overlay di testo dato (valore compilato), font Courier nero come da file mappato fornito. */
function valorePdf_(xCm, yCm, testo, fontPt, stileExtra) {
  if (!testo) return '';
  return overlayPdf_(xCm, yCm, escapeHtmlPdf_(testo), 'font-family:Courier,monospace;font-size:' + (fontPt || 10) + 'pt;color:#000;white-space:nowrap;' + (stileExtra || ''));
}

/**
 * Come valorePdf_, ma centrata sia orizzontalmente che verticalmente sulla coordinata data
 * (xCm/yCm = CENTRO della casella sul modulo, non il suo margine superiore sinistro): più
 * robusta per caselle strette (Km/Tempo di trasferimento, Durata, N. tecnici aggiuntive, Q.tà
 * articoli, Data/ora di chiusura) dove un valore più lungo/corto del previsto non deve sbordare
 * da un lato, e dove la casella è troppo bassa per allineare il testo dal solo margine superiore.
 */
function valoreCentratoPdf_(xCm, yCm, testo, fontPt, stileExtra) {
  if (!testo) return '';
  return overlayPdf_(xCm, yCm, escapeHtmlPdf_(testo), 'font-family:Courier,monospace;font-size:' + (fontPt || 10) + 'pt;color:#000;white-space:nowrap;transform:translate(-50%,-50%);' + (stileExtra || ''));
}

/** "X" di spunta centrata sulla casella alle coordinate (cm, centro della casella) date. */
function spuntaPdf_(xCm, yCm) {
  return overlayPdf_(xCm, yCm, 'X', 'font-family:Arial,sans-serif;font-size:9pt;font-weight:bold;color:#000;transform:translate(-50%,-50%);line-height:1;');
}

/**
 * Firma olografa (immagine PNG data URL), ancorata al margine inferiore del riquadro (xCm/yCm =
 * angolo in alto a sinistra, widthCm/heightCm = dimensioni): la firma disegnata poggia così sulla
 * riga "firma"/"timbro e firma" del modulo invece di fluttuare a metà del riquadro vuoto.
 */
function firmaOverlayPdf_(xCm, yCm, widthCm, heightCm, dataUrl) {
  if (!dataUrl || dataUrl.indexOf('data:image/') !== 0) return '';
  return overlayPdf_(xCm, yCm, '<img src="' + dataUrl + '" style="max-width:100%;max-height:100%;object-fit:contain;">',
    'width:' + cmMm_(widthCm) + ';height:' + cmMm_(heightCm) + ';display:flex;align-items:flex-end;justify-content:center;');
}

/** Nome del file PDF: stesso schema dei nomi cartella Documenti (Documenti.gs), riconoscibile. */
function nomeFilePdfRapporto_(intervento) {
  var codice = intervento.codiceEsterno ? sanitizzaNomeCartella_(intervento.codiceEsterno) : 'SENZA-ODS';
  var cliente = sanitizzaNomeCartella_(intervento.cliente) || '(senza nome)';
  return 'Rapporto di Intervento - ' + codice + ' - ' + cliente + '.pdf';
}

/**
 * Coordinate (in cm) di ogni campo compilato dalla squadra: riprese ESATTAMENTE dal file
 * "rapporto_intervento_layout_base.html" fornito dall'utente (mappatura pixel-precisa fatta sullo
 * stesso sfondo, con veri <input>/<textarea> posizionati in absolute) — non più misurate a occhio.
 * Le caselle (checkbox/radio) sono qui salvate già come CENTRO (left+width/2, top+height/2): usato
 * da spuntaPdf_, che centra anche graficamente la "X". Centralizzate qui per essere l'unico posto
 * da correggere in caso di ritocchi di posizionamento futuri.
 */
var COORD_RAPPORTO_ = {
  tipoIntervento: {
    SOPRALLUOGO: { x: 1.4985, y: 2.7435 }, INSTALLAZIONE: { x: 4.153, y: 2.7435 }, COLLAUDO: { x: 6.82, y: 2.7435 },
    SMONTAGGIO: { x: 8.8905, y: 2.7435 }, 'MANUTENZIONE PREVENTIVA': { x: 11.2525, y: 2.7435 }, 'MANUTENZIONE CORRETTIVA': { x: 15.6215, y: 2.7435 }
  },
  kmAndata: { x: 4.5975, y: 12.726 }, kmRitorno: { x: 6.4645, y: 12.726 },
  tempoOre: { x: 4.2295, y: 13.246 }, tempoMinuti: { x: 4.8895, y: 13.246 },
  tempoRitornoOre: { x: 6.096, y: 13.246 }, tempoRitornoMinuti: { x: 6.7695, y: 13.246 },
  durataDalle: { x: 12.687, y: 12.7385 }, durataAlle: { x: 15.532, y: 12.7385 },
  tecniciAggiuntivi: { x: 18.6315, y: 13.271 },
  articoli: [
    { codX: 1.218, codY: 14.535, qtaX: 5.2835, qtaY: 14.6815, consX: 6.553, consY: 14.656, ritX: 8.115, ritY: 14.643, descX: 8.991, descY: 14.535 },
    { codX: 1.218, codY: 15.348, qtaX: 5.2835, qtaY: 15.4945, consX: 6.553, consY: 15.468, ritX: 8.115, ritY: 15.456, descX: 8.991, descY: 15.348 },
    { codX: 1.218, codY: 16.16, qtaX: 5.2835, qtaY: 16.3065, consX: 6.553, consY: 16.281, ritX: 8.115, ritY: 16.281, descX: 8.991, descY: 16.16 },
    { codX: 1.218, codY: 16.973, qtaX: 5.2835, qtaY: 17.1195, consX: 6.54, consY: 17.094, ritX: 8.115, ritY: 17.094, descX: 8.991, descY: 16.973 },
    { codX: 1.218, codY: 17.786, qtaX: 5.2835, qtaY: 17.9325, consX: 6.553, consY: 17.907, ritX: 8.115, ritY: 17.894, descX: 8.991, descY: 17.786 }
  ],
  note: { x: 1.168, y: 20.705, widthCm: 18.671 },
  conclusoSi: { x: 18.529, y: 23.5205 }, conclusoNo: { x: 19.291, y: 23.5205 },
  dataChiusura: { x: 2.26, y: 26.276 }, oraChiusuraOre: { x: 3.8735, y: 26.276 }, oraChiusuraMinuti: { x: 4.94, y: 26.276 },
  firmaTecnico: { x: 5.842, y: 25.641, w: 5.791, h: 0.8 },
  firmaCliente: { x: 11.811, y: 25.641, w: 8.077, h: 0.8 },
  firmaClienteBis: { x: 9.652, y: 27.622, w: 6.731, h: 0.8 }
};

/** Righe della tabella articoli in overlay: solo quelle con dati (righe vuote nel modulo restano vuote, come sul cartaceo). */
function overlayArticoliPdf_(articoliJson) {
  var articoli = [];
  try { articoli = JSON.parse(articoliJson || '[]'); } catch (e) { articoli = []; }
  if (!Array.isArray(articoli)) articoli = [];
  var righe = COORD_RAPPORTO_.articoli;
  var out = [];
  articoli.slice(0, righe.length).forEach(function (a, idx) {
    var r = righe[idx];
    out.push(valorePdf_(r.codX, r.codY, a.codice, 8));
    out.push(valoreCentratoPdf_(r.qtaX, r.qtaY, a.qta, 8));
    if (a.consegnato) out.push(spuntaPdf_(r.consX, r.consY));
    if (a.ritirato) out.push(spuntaPdf_(r.ritX, r.ritY));
    out.push(valorePdf_(r.descX, r.descY, a.descrizione, 8, 'max-width:' + cmMm_(10.85) + ';overflow:hidden;text-overflow:ellipsis;'));
  });
  return out.join('');
}

/** Costruisce l'HTML del Rapporto di Intervento: sfondo a piena pagina + overlay dei soli campi compilati dalla squadra. */
function generaHtmlRapportoIntervento_(intervento) {
  var tipiSelezionati = [];
  try { tipiSelezionati = JSON.parse(intervento.rapportoTipoIntervento || '[]'); } catch (e) { tipiSelezionati = []; }
  if (!Array.isArray(tipiSelezionati)) tipiSelezionati = [];

  var overlay = [];
  overlay.push(valorePdf_(1.168, 3.966, UNITA_OPERATIVA_RAPPORTO_, 12)); // "SITE SPA": fisso, stessa posizione/stile del file mappato fornito

  TIPI_INTERVENTO_RAPPORTO_.forEach(function (t) {
    if (tipiSelezionati.indexOf(t) !== -1) {
      var pos = COORD_RAPPORTO_.tipoIntervento[t];
      overlay.push(spuntaPdf_(pos.x, pos.y));
    }
  });

  overlay.push(valoreCentratoPdf_(COORD_RAPPORTO_.kmAndata.x, COORD_RAPPORTO_.kmAndata.y, intervento.rapportoKmAndata, 8.5));
  overlay.push(valoreCentratoPdf_(COORD_RAPPORTO_.kmRitorno.x, COORD_RAPPORTO_.kmRitorno.y, intervento.rapportoKmRitorno, 8.5));
  overlay.push(valoreCentratoPdf_(COORD_RAPPORTO_.tempoOre.x, COORD_RAPPORTO_.tempoOre.y, intervento.rapportoTempoTrasferimentoOre, 8.5));
  overlay.push(valoreCentratoPdf_(COORD_RAPPORTO_.tempoMinuti.x, COORD_RAPPORTO_.tempoMinuti.y, intervento.rapportoTempoTrasferimentoMinuti, 8.5));
  overlay.push(valoreCentratoPdf_(COORD_RAPPORTO_.tempoRitornoOre.x, COORD_RAPPORTO_.tempoRitornoOre.y, intervento.rapportoTempoTrasferimentoRitornoOre, 8.5));
  overlay.push(valoreCentratoPdf_(COORD_RAPPORTO_.tempoRitornoMinuti.x, COORD_RAPPORTO_.tempoRitornoMinuti.y, intervento.rapportoTempoTrasferimentoRitornoMinuti, 8.5));
  overlay.push(valoreCentratoPdf_(COORD_RAPPORTO_.durataDalle.x, COORD_RAPPORTO_.durataDalle.y, intervento.rapportoOraInizio, 8.5));
  overlay.push(valoreCentratoPdf_(COORD_RAPPORTO_.durataAlle.x, COORD_RAPPORTO_.durataAlle.y, intervento.rapportoOraFine, 8.5));
  overlay.push(valoreCentratoPdf_(COORD_RAPPORTO_.tecniciAggiuntivi.x, COORD_RAPPORTO_.tecniciAggiuntivi.y, intervento.rapportoTecniciAggiuntivi, 8.5));

  overlay.push(overlayArticoliPdf_(intervento.rapportoArticoli));

  overlay.push(overlayPdf_(COORD_RAPPORTO_.note.x, COORD_RAPPORTO_.note.y,
    escapeHtmlPdf_(intervento.rapportoNote).replace(/\n/g, '<br>'),
    'font-family:Courier,monospace;font-size:8.5pt;color:#000;width:' + cmMm_(COORD_RAPPORTO_.note.widthCm) + ';line-height:1.25;'));

  if (intervento.rapportoConcluso === 'Sì') overlay.push(spuntaPdf_(COORD_RAPPORTO_.conclusoSi.x, COORD_RAPPORTO_.conclusoSi.y));
  else if (intervento.rapportoConcluso === 'No') overlay.push(spuntaPdf_(COORD_RAPPORTO_.conclusoNo.x, COORD_RAPPORTO_.conclusoNo.y));

  if (intervento.rapportoOraChiusura) {
    overlay.push(valoreCentratoPdf_(COORD_RAPPORTO_.dataChiusura.x, COORD_RAPPORTO_.dataChiusura.y, formatDateStr_(dataOggi_()), 7.5));
    var orario = String(intervento.rapportoOraChiusura).split(':');
    overlay.push(valoreCentratoPdf_(COORD_RAPPORTO_.oraChiusuraOre.x, COORD_RAPPORTO_.oraChiusuraOre.y, orario[0] || '', 8.5));
    overlay.push(valoreCentratoPdf_(COORD_RAPPORTO_.oraChiusuraMinuti.x, COORD_RAPPORTO_.oraChiusuraMinuti.y, orario[1] || '', 8.5));
  }

  var fT = COORD_RAPPORTO_.firmaTecnico;
  overlay.push(firmaOverlayPdf_(fT.x, fT.y, fT.w, fT.h, intervento.rapportoFirmaTecnico));
  var fC = COORD_RAPPORTO_.firmaCliente;
  overlay.push(firmaOverlayPdf_(fC.x, fC.y, fC.w, fC.h, intervento.rapportoFirmaCliente));
  var fCbis = COORD_RAPPORTO_.firmaClienteBis;
  overlay.push(firmaOverlayPdf_(fCbis.x, fCbis.y, fCbis.w, fCbis.h, intervento.rapportoFirmaCliente));

  return '<!doctype html><html><head><meta charset="utf-8"><style>' +
    '@page { size: A4; margin: 0; }' +
    'html,body { margin:0; padding:0; }' +
    '.pagina { position:relative; width:210mm; height:297mm; }' +
    '.pagina > img.sfondo { position:absolute; left:0; top:0; width:210mm; height:297mm; }' +
    '</style></head><body>' +
    '<div class="pagina">' +
    '<img class="sfondo" src="data:image/png;base64,' + SFONDO_RAPPORTO_BASE64_ + '">' +
    overlay.join('') +
    '</div></body></html>';
}

/**
 * Genera il PDF del Rapporto e lo salva/sovrascrive nella cartella Documenti Drive dell'intervento
 * (creata al bisogno, stessa cartella del pulsante 📎 "Documenti"): se esisteva già un PDF di un
 * salvataggio precedente (rapportoPdfFileId), viene cestinato prima di crearne uno nuovo, così ne
 * resta sempre e solo uno aggiornato. Ritorna { fileId, url } del nuovo PDF.
 */
function generaEsalvaPdfRapportoIntervento_(intervento) {
  var html = generaHtmlRapportoIntervento_(intervento);
  var nomeFile = nomeFilePdfRapporto_(intervento);
  var blobPdf = Utilities.newBlob(html, 'text/html', nomeFile).getAs('application/pdf');
  blobPdf.setName(nomeFile);

  var folder = otteniCartellaIntervento_(intervento, true);
  if (intervento.rapportoPdfFileId) {
    try { DriveApp.getFileById(intervento.rapportoPdfFileId).setTrashed(true); } catch (e) { /* già rimosso/non trovato: non bloccante */ }
  }
  var file = folder.createFile(blobPdf);
  updateRowFields_('INTERVENTI', intervento._row, { rapportoPdfFileId: file.getId() });
  return { fileId: file.getId(), url: file.getUrl ? file.getUrl() : '' };
}
